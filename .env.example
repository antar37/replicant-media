# Replicant Media deployment settings

# Required for GitHub Actions deployment:
CLOUDFLARE_API_TOKEN=

# Required for live contact submissions:
# The public Jotform form id, e.g. 123456789012345
JOTFORM_FORM_ID=

# Optional: set these if the real Jotform form uses different field names.
# Defaults expected by src/worker.js are shown here.
JOTFORM_FIELD_NAME=q1_name
JOTFORM_FIELD_EMAIL=q2_email
JOTFORM_FIELD_COMPANY=q3_company
JOTFORM_FIELD_WEBSITE=q4_website
JOTFORM_FIELD_SERVICES=q5_services
JOTFORM_FIELD_BUDGET=q6_budget
JOTFORM_FIELD_TIMELINE=q7_timeline
JOTFORM_FIELD_PROJECT_BRIEF=q8_projectBrief
JOTFORM_FIELD_BEST_NEXT_STEP=q9_bestNextStep
